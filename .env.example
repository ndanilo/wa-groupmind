# Copy to .env and adjust as needed.

# --- WhatsApp session ---

# How to link the account. Default "code": shows an 8-character pairing code to type into
# WhatsApp. Set "qr" to print a QR code to scan instead.
PAIRING_MODE=code

# Required in the default "code" mode. Digits only, with country code, no "+" or spaces.
# Example: 15551234567 (US), 5511999999999 (BR), 442071234567 (UK).
# The app refuses to start without it unless you set PAIRING_MODE=qr.
PHONE_NUMBER=

# Folder where WhatsApp session credentials are stored (git-ignored)
AUTH_DIR=.auth

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# How many times to retry a dropped connection before giving up
MAX_RECONNECT_ATTEMPTS=10

# Log message bodies. Off by default: the bot sits in groups full of people who never agreed
# to have their messages written to your disk. Turn it on only while debugging, and see
# PRIVACY.md before you do.
LOG_MESSAGE_CONTENT=false

# Include messages you send yourself. Useful to confirm the bot is working;
# set to false to watch only what other people send you.
LOG_OWN_MESSAGES=true

# --- Request trigger ---

# Comma-separated group JIDs. Leave empty to allow every group the bot is in.
# Example: 120363123456789012@g.us,120363987654321098@g.us
# ALLOWED_GROUP_JIDS=

# Ignore messages older than this many seconds, so reconnecting cannot fire paid runs
# against a replayed backlog.
REQUEST_MAX_AGE_SECONDS=60

# Hard cap on the question text after the @mention is stripped.
MAX_QUESTION_LENGTH=500

# --- Queue / concurrency ---

# How many assistant graph runs may execute at once.
INFOGRAPHIC_CONCURRENCY=3

# Extra requests waiting for a free worker. Beyond this the bot replies "queue full".
INFOGRAPHIC_MAX_QUEUED=10

# Minimum gap between two finished requests from the same user (ms).
USER_COOLDOWN_MS=5000

# Hard ceiling for one job, including queue wait + research + image (ms).
JOB_TIMEOUT_MS=300000

# --- Behaviour ---

# How the bot refers to itself in usage hints (without the leading @).
# Does not affect mention detection — that uses the linked account's JID/LID.
BOT_DISPLAY_NAME=groupmind

# Immediate "looking that up…" reply when a request is accepted. The wording adapts to whether
# the question looks like an image request or a plain question.
SEND_ACK=true

# Best-effort composing presence while a job runs (may be ignored while the client is offline).
TYPING_INDICATOR=true

# Write each poster + JSON sidecar under IMAGE_OUTPUT_DIR. Only affects image replies.
SAVE_GENERATED_IMAGES=true

# For editorial topics (news/politics/economy), fetch real photos via Tavily and pass them
# to the image model as style references (lighting/mood only — faces are not copied).
USE_IMAGE_REFERENCES=true
IMAGE_REFERENCE_COUNT=2

# --- AI providers (required for generation) ---

# OpenRouter key used for both the chat research model and image generation.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Tavily key for web_search / web_extract tools.
# https://app.tavily.com
TAVILY_API_KEY=

# basic | advanced — how thoroughly Tavily reads each result, and the main Tavily cost
# driver. Tavily bills by depth rather than by result count, so "advanced" costs more per
# search. It is the default because the snippets are what an answer gets attributed from:
# on "basic" a result is a couple of sentences, enough to know a story exists and not
# enough to know who acted in it. Set to "basic" to halve the cost for thinner evidence.
SEARCH_DEPTH=advanced

# Chat model — must support tool calling. Any OpenRouter slug.
CHAT_MODEL=deepseek/deepseek-v4-flash-0731

# Per chat completion attempt (research / brief). Structured briefs need headroom.
CHAT_REQUEST_TIMEOUT_MS=120000
CHAT_MAX_RETRIES=2

# Image model — any OpenRouter slug whose output modality is image.
# Browse: https://openrouter.ai/models?output_modalities=image
IMAGE_MODEL=bytedance-seed/seedream-4.5

# Leave blank to reuse OPENROUTER_API_KEY. Set both to point image generation at another account.
# IMAGE_API_KEY=
IMAGE_API_HOST=https://openrouter.ai/api/v1

# 1:1 2:3 3:2 3:4 4:3 4:5 5:4 9:16 16:9 auto — infographics read top to bottom
IMAGE_ASPECT_RATIO=9:16

# 512 | 1K | 2K | 4K — below 2K the small labels come back unreadable
IMAGE_RESOLUTION=2K

# png | jpeg | webp — jpeg keeps WhatsApp sends smaller at 2K
IMAGE_OUTPUT_FORMAT=jpeg

# Optional palette override, e.g. for brand colours. Leave empty and the model picks
# a vivid palette to suit each subject.
# IMAGE_PALETTE=

# A 2K render routinely outlasts a chat completion
IMAGE_REQUEST_TIMEOUT_MS=180000

# Git-ignored output folder. Keep in sync with .gitignore if you change it.
IMAGE_OUTPUT_DIR=generated-images

# Language of every reply: text answers and the labels drawn on posters (BCP-47).
# A tag with a region also tells Tavily which country's sources to rank first
# ("pt-BR" boosts Brazil, "es-MX" boosts Mexico). A plain "en" applies no boost.
OUTPUT_LANGUAGE=en

# ---------------------------------------------------------------------------
# Notification webhook
# ---------------------------------------------------------------------------
# An HTTP endpoint an external system POSTs to, which then forwards the message
# (and any attached file) to a WhatsApp recipient. Completely separate from the
# @mention bot above. See src/notifications/README.md for the request format.

# Off by default. Leave this unset and the bot behaves exactly as it always has.
NOTIFY_ENABLED=false

# Loopback by default, so the port is not reachable from your network. Only widen
# this to 0.0.0.0 once you have put a reverse proxy with TLS in front of it.
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=3001

# Required whenever NOTIFY_ENABLED=true — the app refuses to boot without it, because
# an open endpoint would let anyone send WhatsApp messages as you. Callers pass it
# as the `x-api-key` header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTIFY_API_KEY=

# Per file, in bytes. Files are held in memory until the job runs, so the ceiling
# here multiplied by NOTIFY_CONCURRENCY is roughly the worst-case memory cost.
NOTIFY_MAX_FILE_BYTES=10485760
NOTIFY_MAX_FILES=4
NOTIFY_MAX_MESSAGE_LENGTH=4096

# Its own worker pool, kept separate from the infographic queue so a burst of
# notifications cannot starve the bot (and vice versa).
NOTIFY_CONCURRENCY=2
NOTIFY_MAX_QUEUED=50

# Optional allowlist of recipients (comma separated digits or JIDs). Empty means
# any recipient is accepted. Worth setting while you are still testing.
# NOTIFY_ALLOWED_RECIPIENTS=

# Prepended when a caller sends a local number without a country code. Leave empty
# to require callers to always include it. E.g. 1 for the US, 55 for Brazil, 44 for the UK.
# NOTIFY_DEFAULT_COUNTRY_CODE=

# How long a finished job stays queryable through GET /notifications/:id
NOTIFY_JOB_TTL_MS=3600000

# How long a delivery waits for a reconnecting WhatsApp socket before giving up
NOTIFY_READY_TIMEOUT_MS=30000

# Whole-job ceiling, so a hung upload cannot hold a worker slot forever.
# Keep this comfortably above NOTIFY_READY_TIMEOUT_MS.
NOTIFY_JOB_TIMEOUT_MS=120000
