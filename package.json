{
  "name": "whatsapp-infographic",
  "version": "0.2.0",
  "description": "WhatsApp group bot that researches a question and replies with an AI-generated infographic",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=./src --import tsx --env-file-if-exists=.env src/index.ts",
    "dev:stable": "node --import tsx --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "notify:server": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "langchain:server": "npx @langchain/langgraph-cli dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndanilo/whatsapp_monitor.git"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "infographic",
    "langchain",
    "nodejs",
    "typescript"
  ],
  "author": "Danilo Novais",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ndanilo/whatsapp_monitor/issues"
  },
  "homepage": "https://github.com/ndanilo/whatsapp_monitor#readme",
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.4",
    "@langchain/tavily": "^1.2.0",
    "baileys": "^7.0.0-rc14",
    "fastify": "^5.12.3",
    "langchain": "^1.5.3",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
